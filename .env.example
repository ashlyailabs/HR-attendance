# Copy to `.env.local` and fill in values from your Google Cloud service account.

GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# One Google Sheet ID per company (see lib/companies.ts).
GOOGLE_SHEET_ID_INDUSTRIES=
GOOGLE_SHEET_ID_PVT_LTD=

# Optional: secret for POST /api/clear-sheet-data (clears Sheet1 rows 2+; keeps header).
# CLEAR_SHEET_TOKEN=
